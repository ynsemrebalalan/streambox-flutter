<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!--
	    Desteklenen diller. Bu anahtar OLMADAN iOS, uygulamanin yalnizca
	    development region dilini destekledigini varsayar; cihaz dili
	    Ispanyolca/Almanca/vb. olsa bile Flutter'a yanlis locale gelir ve
	    "sistem dilini takip et" secenegi calismaz. Uygulama ici dil secici
	    bundan bagimsiz calisir. AppLocalizations.supportedLocales ile ayni
	    liste olmali.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
		<string>de</string>
		<string>it</string>
		<string>es</string>
		<string>ro</string>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>IPTV Ai Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>StreamBox</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- CADisableMinimumFrameDurationOnPhone kasten kaldirildi:
	     iOS 26.4.1 + ProMotion (iPhone 14/17 Pro Max) Flutter'da
	     createTouchRateCorrectionVSyncClientIfNeeded -> VSyncClient init
	     null CADisplayLink hatasina yol aciyor, siyah ekran oluyor.
	     60Hz fallback yeterli; video oynatma etkilenmiyor. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- iPad multitasking support -->
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportsFullScreen</key>
	<true/>
	<!-- Network access required for IPTV streaming -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Background modes:
	     audio  — arka planda ses devam eder (live TV / film) + AirPlay
	     NOT: 'picture-in-picture' UIBackgroundModes enum'unda DEGIL (ASC reject 90112).
	     PiP icin Info.plist key gerekmez; AVPictureInPictureController native API'si
	     audio mode + AVAudioSession.playback ile calisir. media_kit Texture-based
	     oldugu icin iOS PiP zaten devre disi (Pro features memo). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- App does not use non-exempt encryption -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Sign-In client ID (GoogleService-Info.plist icindeki CLIENT_ID).
	     GoogleService-Info.plist Xcode bundle'ina EKLI DEGIL; bu anahtar
	     olmadan GIDSignIn client ID bulamayip NSException firlatiyor ve
	     plugin onu yeniden firlattigi icin uygulama cokuyordu (2026-08-29).
	     auth_repository.dart ayrica clientId'yi Dart'tan da veriyor —
	     ikisi birlikte savunma katmani. -->
	<key>GIDClientID</key>
	<string>583696434507-dp78u7jc99i07f28qb4othk7quk73tfq.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>583696434507-o0bs6rvbmbndn01k8191epkusd2aufls.apps.googleusercontent.com</string>
	<!-- Firebase Auth / Google Sign-In URL scheme (REVERSED_CLIENT_ID) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.583696434507-dp78u7jc99i07f28qb4othk7quk73tfq</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
